+  /**
+   * Register an out-of-repository plugin event as required persistence
+   * vocabulary for this Host runtime. The returned disposer is idempotent;
+   * duplicate registrations keep the type live until the final disposer.
+   */
+  registerEventType(type: string): () => void {
+    if (type.trim() === '') throw new Error('session event type must not be empty')
+    const catalog = KNOWN_SESSION_EVENT_TYPES as Set<string>
+    const existing = runtimeEventTypeReferences.get(type)
+    if (existing === undefined) {
+      runtimeEventTypeReferences.set(type, { count: 1, alreadyKnown: catalog.has(type) })
+      catalog.add(type)
+    } else {
+      existing.count += 1
+    }
+
+    let active = true
+    return () => {
+      if (!active) return
+      active = false
+      const entry = runtimeEventTypeReferences.get(type)
+      if (entry === undefined) return
+      entry.count -= 1
+      if (entry.count > 0) return
+      runtimeEventTypeReferences.delete(type)
+      if (!entry.alreadyKnown) catalog.delete(type)
+    }
+  }
